FROM python:3.14-slim@sha256:ce40764625a4ff50df3548277632e7f96c4e77fe75fa848aae9885476e7df5a4

ARG APP_UID=10001
ARG APP_GID=10001

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HOME=/tmp/modacct-home

RUN groupadd --gid ${APP_GID} modacct \
    && useradd --uid ${APP_UID} --gid ${APP_GID} --no-create-home --shell /usr/sbin/nologin modacct

WORKDIR /app

COPY requirements-container.lock ./
RUN python -m pip install \
      --disable-pip-version-check \
      --no-cache-dir \
      --require-hashes \
      --only-binary=:all: \
      --no-deps \
      -r requirements-container.lock \
    && python -m pip check

COPY --chown=${APP_UID}:${APP_GID} . .
RUN install -d -o ${APP_UID} -g ${APP_GID} /data /tmp/modacct-home

USER ${APP_UID}:${APP_GID}

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
